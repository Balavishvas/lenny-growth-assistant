# Application
APP_ENV=development
APP_NAME=Lenny Growth Assistant
LOG_LEVEL=INFO

# PostgreSQL (local development; never put real credentials in Git)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth

# Agent orchestration: ollama keeps the native path; pi uses Pi Coding Agent\nAGENT_RUNTIME=ollama\n\n# Local chat model
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=60
LLM_NUM_PREDICT=384
OLLAMA_KEEP_ALIVE=10m

# Local embeddings (Nomic Embed Text v1.5 returns 768 dimensions by default)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
TRANSCRIPT_DIR=data-source/episodes

# Optional cloud provider (leave blank for local-only development)
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# Retrieval and chunking
RETRIEVAL_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=120
