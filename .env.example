# Application
APP_ENV=development
APP_NAME=Lenny Growth Assistant
LOG_LEVEL=INFO

# PostgreSQL (local development; never put real credentials in Git)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth

# Local model provider
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=60

# Optional cloud provider (leave blank for local-only development)
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# Retrieval defaults (to be wired into the retrieval service)
RETRIEVAL_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=120
